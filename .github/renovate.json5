{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // best-practices: pins GitHub Actions to digests (keeping the version
  // comments the workflows already carry), config migration, etc.
  extends: [
    'config:best-practices',
    ':semanticCommitsDisabled',
  ],
  // Batch the noise: everything lands early Monday, non-major Go updates in
  // one PR. Majors, actions, and mise tools stay individual.
  schedule: ['before 6am on monday'],
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'go dependencies (non-major)',
    },
    {
      // cue is load-bearing (embedded evaluator + schema semantics, see the
      // 0.17.x interpolation regression doc): never auto-bump past a minor.
      matchPackageNames: ['cuelang.org/go', 'cue'],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
    },
  ],
}
