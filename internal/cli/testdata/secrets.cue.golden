package registries

import "github.com/lugoues/creidhne"

// Managed by crei (crei secret create/rotate). Declares the podman secrets
// crei owns and how to generate them; secret values never live here.
secrets: creidhne.#SecretRegistry & {
	api_key: generate: {length: 24, charset: "hex"}
	db_password: generate: {length: 40}
	plain: _
	session: {name: "session-key", generate: {length: 64, charset: "base64"}}
	tls: name: "tls-cert"
}
