
[Container]
Image=svc.build
ContainerName=svc
Volume=svc-data.volume:/data:ro,U
Mount=type=volume,source=svc-data.volume,destination=/mnt,ro
Mount=type=tmpfs,destination=/tmp,tmpfs-size=64m,ro
Annotation=creidhne.build-hash=96357087110e
LogDriver=journald
LogOpt=label=QUADLET=svc
LogOpt=label=QUADLET_UNIT_NAME=svc
LogOpt=label=IMAGE=svc.build

[Install]
WantedBy=default.target
